# Supabase — obtenha em app.supabase.com > Project Settings > API
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
SUPABASE_JWT_SECRET=sua_jwt_secret_aqui

# Redis — Upstash: redis.upstash.com
REDIS_URL=redis://localhost:6379

# IA — Gemini (primário, grátis) e OpenAI (fallback)
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Sentry (opcional em dev)
SENTRY_DSN=

# Ambiente
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:8081","exp://localhost:8081"]
